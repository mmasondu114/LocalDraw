{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "reading_direction": {
      "type": "string",
      "enum": [
        "LTR",
        "RTL"
      ]
    },
    "layout": {
      "type": "string"
    },
    "page_turn_note": {
      "type": "string"
    },
    "state_in": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "panels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "page_id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          },
          "aspect_ratio": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,3}:[1-9][0-9]{0,3}$"
          },
          "shot": {
            "type": "string"
          },
          "angle": {
            "type": "string"
          },
          "composition": {
            "type": "string"
          },
          "scene_id": {
            "type": "string"
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "character_id": {
                  "type": "string"
                },
                "position": {
                  "type": "string"
                },
                "gaze": {
                  "type": "string"
                },
                "action": {
                  "type": "string"
                },
                "expression": {
                  "type": "string"
                }
              },
              "required": [
                "character_id",
                "position",
                "gaze",
                "action",
                "expression"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "main_instant": {
            "type": "string"
          },
          "background": {
            "type": "string"
          },
          "props": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "prop_id": {
                  "type": "string"
                },
                "position": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                }
              },
              "required": [
                "prop_id",
                "position",
                "state"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "transition_in": {
            "type": "string"
          },
          "transition_out": {
            "type": "string"
          },
          "state_after": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "drawing_description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "page_id",
          "number",
          "purpose",
          "layout",
          "aspect_ratio",
          "shot",
          "angle",
          "composition",
          "scene_id",
          "characters",
          "main_instant",
          "background",
          "props",
          "transition_in",
          "transition_out",
          "state_after",
          "drawing_description"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "lettering": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "panel_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "dialogue",
              "narration",
              "sfx"
            ]
          },
          "speaker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "bubble_position": {
            "type": "string"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "panel_id",
          "kind",
          "speaker_id",
          "text",
          "bubble_position",
          "order"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "state_out": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "layout_rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weight": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 4
          },
          "panels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "panel_id": {
                  "type": "string"
                },
                "weight": {
                  "type": "number",
                  "minimum": 0.5,
                  "maximum": 4
                }
              },
              "required": [
                "panel_id",
                "weight"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 3
          }
        },
        "required": [
          "weight",
          "panels"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 5
    }
  },
  "required": [
    "id",
    "number",
    "reading_direction",
    "layout",
    "page_turn_note",
    "state_in",
    "panels",
    "lettering",
    "state_out"
  ],
  "additionalProperties": false
}
