{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "scene_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "character_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          },
          "panel_count": {
            "type": "integer",
            "minimum": 1
          },
          "purpose": {
            "type": "string"
          },
          "beat": {
            "type": "string"
          },
          "hook": {
            "type": "string"
          },
          "reveal": {
            "type": "string"
          },
          "turn_after": {
            "type": "boolean"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "number",
          "scene_ids",
          "character_ids",
          "panel_count",
          "purpose",
          "beat",
          "hook",
          "reveal",
          "turn_after",
          "constraints"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "pages"
  ],
  "additionalProperties": false
}
