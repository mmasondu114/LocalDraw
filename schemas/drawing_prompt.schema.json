{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "panel_id": {
      "type": "string"
    },
    "positive": {
      "type": "string"
    },
    "negative": {
      "type": "string"
    },
    "composition_variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "maxItems": 6
    },
    "character_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "character_id": {
            "type": "string"
          },
          "tags": {
            "type": "string"
          }
        },
        "required": [
          "character_id",
          "tags"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "adaptation_notes": {
      "type": "string"
    },
    "framing": {
      "type": "object"
    },
    "visual_plan": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "detailed_scene": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1800
        },
        "must_show": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 12
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 8
        },
        "uncertain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "maxItems": 8
        }
      },
      "required": [
        "version",
        "detailed_scene",
        "must_show",
        "relationships",
        "uncertain"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "panel_id",
    "positive",
    "negative",
    "composition_variants",
    "character_anchors",
    "adaptation_notes"
  ],
  "additionalProperties": false
}
